# Ambiente
NODE_ENV=development
FUSO_HORARIO=America/Bahia

# Portal
NOME_PORTAL=MOVE.ON
DESCRICAO_PORTAL=Conteúdo que move
URL_PUBLICA_PORTAL=http://localhost:3000
CAMINHO_LOGO=/logo.png
CAMINHO_FAVICON=/favicon.svg
CAMINHO_IMAGEM_SOCIAL=/og.png

# API
HOST_API=127.0.0.1
PORTA_API=3001
URL_INTERNA_API=http://127.0.0.1:3001
ORIGENS_PERMITIDAS=http://localhost:3000,http://127.0.0.1:3000
LIMITE_CORPO_JSON=64kb
PASTA_UPLOADS=uploads
MAX_IMAGEM_CAPA_MB=8
MAX_VIDEO_MB=250
LIMPEZA_MIDIAS_ORFAS_HORAS=24
INTERVALO_LIMPEZA_MIDIAS_MINUTOS=360
LIMITE_PUBLICACOES_DESTAQUE=5

# E-mail / newsletter
EMAIL_ATIVO=false
SMTP_HOST=smtp.exemplo.com
SMTP_PORTA=587
SMTP_SEGURO=false
SMTP_USUARIO=usuario_smtp
SMTP_SENHA=senha_smtp
EMAIL_REMETENTE_NOME=MOVE.ON
EMAIL_REMETENTE_ENDERECO=newsletter@exemplo.com
EMAIL_SEGREDO_CANCELAMENTO=troque_por_um_segredo_com_mais_de_32_caracteres
MAX_CADASTROS_NEWSLETTER_POR_IP=5
JANELA_NEWSLETTER_MINUTOS=60
NOME_COOKIE_VISITANTE=moveon_visitante_seguro
DURACAO_COOKIE_VISITANTE_DIAS=365
MAX_REACOES_POR_IP_HORA=30
MAX_MENSAGENS_CONTATO_POR_IP_HORA=5

# PostgreSQL — substitua por valores próprios
POSTGRES_IMAGEM=postgres:17-alpine
POSTGRES_CONTAINER=moveon_postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORTA=5434
POSTGRES_PORTA_INTERNA=5432
POSTGRES_BANCO=moveon
POSTGRES_USUARIO=moveon
POSTGRES_SENHA=troque_esta_senha
DATABASE_URL=postgresql://moveon:troque_esta_senha@127.0.0.1:5434/moveon
BANCO_MAX_CONEXOES=10
BANCO_TEMPO_OCIOSO_MS=20000
BANCO_TEMPO_CONEXAO_MS=5000

# Redis — fila assíncrona e coordenação entre instâncias
REDIS_ATIVO=true
REDIS_IMAGEM=redis:8-alpine
REDIS_CONTAINER=moveon_redis
REDIS_HOST=127.0.0.1
REDIS_PORTA=6380
REDIS_SENHA=troque_esta_senha_redis
REDIS_URL=redis://:troque_esta_senha_redis@127.0.0.1:6380
REDIS_PREFIXO=moveon

# Autenticação
NOME_COOKIE_SESSAO=moveon_sessao
DURACAO_SESSAO_DIAS=30
COOKIE_SAMESITE=strict
COOKIE_SEGURO=false
MAX_TENTATIVAS_LOGIN=8
MAX_LOGINS_SIMULTANEOS_POR_IP=2
JANELA_TENTATIVAS_MINUTOS=15
BLOQUEIO_LOGIN_INICIAL_SEGUNDOS=60
BLOQUEIO_LOGIN_MAX_DIAS=7
RECUPERACAO_EXPIRACAO_MINUTOS=30
RECUPERACAO_INTERVALO_MINUTOS=5
RECUPERACAO_MAX_POR_IP_HORA=5
CUSTO_HASH_SENHA=12

# Administrador inicial — use uma senha forte e exclusiva
ADMIN_NOME=Administrador MOVE.ON
ADMIN_EMAIL=admin@moveon
ADMIN_SENHA=troque_esta_senha_inicial

# Dados iniciais, separados por vírgula
CATEGORIAS_INICIAIS=Tecnologia,Cidades,Sustentabilidade,Educação,Negócios,Bem-estar
